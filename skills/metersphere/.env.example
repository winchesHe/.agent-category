# 必填：MeterSphere 实例与 API 密钥
METERSPHERE_BASE_URL=https://metersphere.example.com
METERSPHERE_ACCESS_KEY=
METERSPHERE_SECRET_KEY=

# 可选：显式指定另一个 .env；优先级低于进程环境，高于 CWD/skill 根目录
METERSPHERE_ENV_FILE=
METERSPHERE_TIMEOUT_SECONDS=60

# 常用默认范围
METERSPHERE_PROJECT_ID=
METERSPHERE_ORGANIZATION_ID=100001
METERSPHERE_WORKSPACE_ID=

# 可选请求参数
METERSPHERE_HEADERS_JSON=
METERSPHERE_PROTOCOLS_JSON='["HTTP"]'
METERSPHERE_DEFAULT_MAINTAINER=
METERSPHERE_DEFAULT_VERSION_ID=
METERSPHERE_DEFAULT_NODE_PATH=
METERSPHERE_NODE_PATH_MAP_JSON=
