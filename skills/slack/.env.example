# Slack Web API token 配置。
# 普通读取 auto 按 User -> Bot，写操作 auto 在写前按 User -> Bot 预检目标可达性。
# 全局搜索需要带 search:read scope 的 user token。
# 写操作必须经过用户明确确认；Bot/User token 都可承担写入，但各自必须有对应 scope。

# 用途：Bot token，通常以 xoxb- 开头；用于频道/用户查询、历史消息、thread 回复、文件下载和写操作。
# 获取方式：Slack App -> OAuth & Permissions -> Bot User OAuth Token；常用 scopes 包括 channels:read、channels:history、groups:read、groups:history、users:read、files:read、chat:write、files:write、reactions:write。
SLACK_BOT_TOKEN=

# 用途：User token，通常以 xoxp- 开头；用于默认读取、全局搜索和默认写入。
# 获取方式：Slack App -> OAuth & Permissions -> User OAuth Token；search 至少需要 search:read；写入还需 chat:write/files:write/reactions:write。
SLACK_USER_TOKEN=

# 可选
# 用途：可选 fallback token；仅在对应操作专用 token 缺失时兜底。
# 获取方式：只在迁移旧配置时使用；新配置优先填 SLACK_BOT_TOKEN / SLACK_USER_TOKEN。
SLACK_TOKEN=

# 用途：默认读/写 actor。auto 才允许在安全的只读阶段选择另一身份；显式 bot/user 永不 fallback。
SLACK_READ_ACTOR=auto
SLACK_WRITE_ACTOR=auto

# 用途：可选频道 allowlist；限制 skill 只能访问这些频道，多个值用英文逗号分隔。
# 获取方式：Slack 频道详情或 URL 中的 C.../G... ID；建议填频道 ID，避免重名。
SLACK_SKILL_ALLOWED_CHANNELS=

# 用途：HTTP 超时时间，单位秒。
# 获取方式：通常保持默认；Slack API 偶发慢响应时再调大。
SLACK_SKILL_TIMEOUT=60

# 用途：写请求遇到 HTTP 429 时允许等待的累计秒数。Retry-After 超出预算会停止，不会截短后重试。
SLACK_SKILL_WRITE_RETRY_BUDGET=30

# 用途：可选缓存根目录；V2 会在其下按 team/actor 隔离。
# 获取方式：本机/容器可写路径；上云时建议挂载持久卷或临时卷。
SLACK_SKILL_CACHE_DIR=

# 用途：可选文件下载根目录；V2 会在其下按 team/actor 隔离。
# 获取方式：本机/容器可写路径；用于下载附件，空间不足时改到大容量目录。
SLACK_SKILL_FILES_DIR=

# 用途：默认下载的文件类型；可选 text、image、video、audio、pdf、archive、other、all。
# 获取方式：按排查需要选择；生产建议从 text/pdf/image 起步，避免误下大文件。
SLACK_SKILL_DOWNLOAD_TYPES=text

# 用途：缓存 TTL，单位秒；控制 users/channels/subteams 缓存保留多久。
# 获取方式：通常保持默认；频道/用户变更频繁时调小。
SLACK_SKILL_CACHE_TTL=259200

# 用途：是否禁用 users/channels/subteams 缓存自动刷新；设为 1 表示禁用。
# 获取方式：调试缓存问题时临时设 1；正常运行保持 0。
SLACK_SKILL_CACHE_NO_AUTO=0
