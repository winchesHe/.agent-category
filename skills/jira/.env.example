# Jira connection config. Copy to jira/.env and fill in values.
# Priority: process env > CWD/.env > skill root .env

JIRA_BASE_URL=https://moego.atlassian.net
JIRA_LOGIN=
JIRA_API_TOKEN=

JIRA_TIMEOUT=30
JIRA_MAX_ATTACHMENT_BYTES=20971520

# Optional: Intercom for Jira linked conversations.
JIRA_INTERCOM_JWT=
JIRA_INTERCOM_JWT_COMMAND=
JIRA_INTERCOM_GRAPHQL_URL=https://intercom-for-jira-production.toolsplus.app/api/intercom/graphql
JIRA_INTERCOM_REFERRER=
JIRA_INTERCOM_TIMEOUT=30
