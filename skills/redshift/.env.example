# 复制为 .env。完整配置步骤与安全要求见 README.md 的 Quickstart。

# Wire/password connection 使用的只读数据库用户名。
WAREHOUSE_USER=

# Wire/password connection 使用的只读数据库密码。
WAREHOUSE_PASSWORD=

# Wire TLS verify-full 使用的 CA bundle 绝对路径；macOS 使用 /etc/ssl/cert.pem。
WAREHOUSE_CA=

# 可选：CSV/NDJSON artifact 使用的私有 0700 目录绝对路径。
REDSHIFT_OUTPUT_DIR=
