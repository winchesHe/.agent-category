# 用途：GrowthBook Management API Bearer token；供 get-projects、get-feature-flags、create-feature-flag、create-force-rule 等管理类读写命令使用。
# 获取方式：GrowthBook -> Settings/API Keys，或个人/组织 API token 页面创建 Management API token。
GROWTHBOOK_API_TOKEN=替换为-growthbook-api-token

# 用途：GrowthBook Management API 地址；管理类命令会向这里请求 /api/v1/*。这是目标系统定位，不应依赖代码默认值。
# 获取方式：从部署配置的 API host、GrowthBook 管理后台或浏览器 Network 里 `/api/v1/...` 请求 host 获取。
GROWTHBOOK_API_BASE_URL=https://growthbook.moego.pet/growthbook-api

# 用途：GrowthBook SDK Connection API host；eval-feature 会通过 Node SDK 下载 feature payload 并在本地评估。
# 获取方式：GrowthBook -> SDK Connections -> 目标环境连接详情复制 API host；自托管时它可能与 GROWTHBOOK_API_BASE_URL 相同。
GROWTHBOOK_SDK_API_HOST=https://growthbook.moego.pet/growthbook-api

# 用途：SDK Connection client key；指定 eval-feature 要评估的环境。
# 获取方式：GrowthBook -> SDK Connections -> 对应环境的 client key；production/development 要分别确认。
GROWTHBOOK_SDK_CLIENT_KEY=替换为-sdk-client-key

# 可选调优
# 用途：可选 SDK 初始化超时时间，单位毫秒；控制 eval-feature 等待 feature payload 的时间。
# 获取方式：通常保持默认；SDK endpoint 慢或跨网络访问时再调大。
GROWTHBOOK_SDK_TIMEOUT_MS=10000

# 用途：可选 Node runtime 路径；Python wrapper 会用它启动 SDK evaluator。
# 获取方式：本机直接用 node；容器里如有固定路径可填 `/usr/local/bin/node`。
GROWTHBOOK_NODE_BIN=node

# 用途：可选 env 文件路径；显式指定后优先从该文件加载配置。
# 获取方式：只有需要共享或集中管理 env 文件时填写绝对路径；常规部署留空。
GROWTHBOOK_DOTENV=

# 旧配置兼容别名。新安装不需要填写；迁移期间脚本仍支持这些 key，且新变量优先。
# GB_TOKEN=
# GB_APP_ORIGIN=
# GB_DOTENV=
