{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weekly-work-review/evidence-manifest.schema.json",
  "title": "Weekly Work Review Evidence Manifest",
  "description": "schema 1.2：日期范围周目录 + 多 agent session 证据。字段定义以本文件为准，散文契约不再重复声明必填字段。",
  "type": "object",
  "required": [
    "schema_version",
    "week_start",
    "week_end",
    "iso_week",
    "week_label",
    "timezone",
    "archive_dir",
    "archive_shape",
    "report_path",
    "generated_at",
    "sources_scanned",
    "queries_run",
    "empty_results",
    "candidate_items",
    "output_items",
    "indexed_items",
    "used_in_report",
    "excluded_with_reason",
    "coverage_summary"
  ],
  "properties": {
    "schema_version": { "const": "1.2" },
    "week_start": { "$ref": "#/$defs/date", "description": "复盘周周一" },
    "week_end": { "$ref": "#/$defs/date", "description": "复盘周周日" },
    "iso_week": {
      "type": "string",
      "pattern": "^\\d{4}-W\\d{2}$",
      "description": "机器元数据；不进入目录名"
    },
    "week_label": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2} 至 (\\d{2}-\\d{2}|\\d{4}-\\d{2}-\\d{2})$",
      "description": "人可读日期范围，等于周目录名"
    },
    "timezone": { "type": "string", "minLength": 1 },
    "archive_dir": { "type": "string", "minLength": 1 },
    "archive_shape": { "const": "date-range-week-dir" },
    "report_path": {
      "type": "string",
      "pattern": "周复盘\\.md$",
      "description": "周目录内主报告文件名，形如 <week_label> 周复盘.md"
    },
    "generated_at": { "type": "string", "minLength": 1 },
    "sources_scanned": { "$ref": "#/$defs/sourcesScanned" },
    "queries_run": { "type": "array" },
    "empty_results": { "type": "array" },
    "candidate_items": { "type": "array", "items": { "$ref": "#/$defs/candidateItem" } },
    "output_items": { "type": "array", "items": { "$ref": "#/$defs/outputItem" } },
    "indexed_items": { "type": "array", "items": { "$ref": "#/$defs/indexedItem" } },
    "used_in_report": { "type": "array", "items": { "$ref": "#/$defs/usedInReport" } },
    "excluded_with_reason": { "type": "array", "items": { "$ref": "#/$defs/excludedItem" } },
    "coverage_summary": { "$ref": "#/$defs/coverageSummary" }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sourceStatus": {
      "enum": [
        "scanned",
        "partial",
        "zero_result",
        "skipped_by_user",
        "tool_unavailable",
        "permission_denied",
        "not_applicable"
      ]
    },
    "source": {
      "type": "object",
      "required": ["status", "tool", "raw_count", "candidate_count", "used_count"],
      "properties": {
        "status": { "$ref": "#/$defs/sourceStatus" },
        "tool": { "type": "string" },
        "query": { "type": "string" },
        "artifact_path": { "type": "string" },
        "raw_count": { "type": "integer", "minimum": 0 },
        "candidate_count": { "type": "integer", "minimum": 0 },
        "used_count": { "type": "integer", "minimum": 0 },
        "skipped_reason": { "type": "string" }
      }
    },
    "sourcesScanned": {
      "type": "object",
      "description": "每个 key 必须出现，未执行也要写明状态与原因",
      "required": [
        "sessions",
        "slack_outbound",
        "slack_inbound",
        "lark_vc",
        "lark_calendar",
        "lark_minutes_owner",
        "lark_minutes_participant",
        "shared_clip_link_extraction",
        "shared_clip_keyword_search",
        "lark_drive_docs",
        "local_vault_notes",
        "personal_outputs",
        "github_activity",
        "jira_issues",
        "jira_worklog"
      ],
      "additionalProperties": { "$ref": "#/$defs/source" }
    },
    "candidateItem": {
      "type": "object",
      "required": [
        "id",
        "type",
        "title",
        "date",
        "source_key",
        "source",
        "source_path_or_token",
        "discovery_method",
        "evidence_ref",
        "used_in",
        "confidence",
        "sensitivity"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "enum": [
            "session",
            "meeting",
            "shared-clip",
            "shared-minute",
            "slack-thread",
            "doc",
            "local-note",
            "github",
            "jira",
            "jira-linear"
          ]
        },
        "title": { "type": "string" },
        "date": { "$ref": "#/$defs/date" },
        "source_key": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "source_path_or_token": { "type": "string" },
        "discovery_method": { "type": "string" },
        "evidence_ref": { "type": "string" },
        "used_in": { "type": "array", "items": { "type": "string" } },
        "confidence": { "enum": ["high", "medium", "low"] },
        "sensitivity": { "enum": ["public", "personal", "internal", "confidential", "restricted"] },
        "agent": {
          "type": "string",
          "description": "session 候选的 agent：claude / codex / opencode / pi / copilot / cursor"
        },
        "minute_token": { "type": "string" },
        "note_doc_token": { "type": "string" },
        "note_doc_url": { "type": "string" },
        "verbatim_doc_token": { "type": "string" },
        "verbatim_doc_url": { "type": "string" },
        "meeting_note_link": {
          "type": "string",
          "description": "指向 工作/会议 权威归档的 wikilink 或相对路径"
        },
        "pdf_export_path": { "type": "string" },
        "pdf_unavailable_reason": { "type": "string" },
        "transcript_status": {
          "enum": ["valid", "empty", "metadata_only", "permission_denied", "suspiciously_short", "unavailable"]
        },
        "token_unavailable_reason": { "type": "string" }
      }
    },
    "outputItem": {
      "type": "object",
      "required": [
        "id",
        "category",
        "title",
        "status",
        "evidence_refs",
        "report_anchor",
        "used_in",
        "sprint_review_selected"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "category": {
          "enum": [
            "company-delivery",
            "engineering",
            "operations",
            "communication",
            "writing-creation",
            "knowledge-system",
            "personal-project"
          ]
        },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["published", "completed", "live", "in-progress", "blocked", "paused"] },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "report_anchor": { "type": "string", "minLength": 1 },
        "used_in": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "sprint_review_selected": { "type": "boolean" }
      }
    },
    "indexedItem": {
      "type": "object",
      "required": ["candidate_id", "index_path", "row_key", "source_type"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "index_path": { "type": "string", "minLength": 1 },
        "row_key": { "type": "string" },
        "source_type": {
          "enum": [
            "vc",
            "calendar",
            "minutes-owner",
            "minutes-participant",
            "shared-minute",
            "shared-clip",
            "manual-link"
          ]
        }
      }
    },
    "usedInReport": {
      "type": "object",
      "required": ["candidate_id", "report_section", "anchor_text", "claim_supported"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "report_section": { "type": "string", "minLength": 1 },
        "anchor_text": { "type": "string" },
        "claim_supported": { "type": "string" }
      }
    },
    "excludedItem": {
      "type": "object",
      "required": ["candidate_id", "reason"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "reason": {
          "enum": [
            "background",
            "duplicate",
            "low-signal",
            "sensitive",
            "off-scope",
            "superseded",
            "already-covered"
          ]
        },
        "detail": { "type": "string" }
      }
    },
    "coverageSummary": {
      "type": "object",
      "required": [
        "total_candidates",
        "total_used",
        "total_outputs",
        "outputs_in_report",
        "output_coverage_ratio",
        "high_signal_candidates",
        "high_signal_used",
        "high_signal_usage_ratio",
        "shared_clip_candidates",
        "shared_clip_indexed",
        "sources_missing"
      ],
      "properties": {
        "total_candidates": { "type": "integer", "minimum": 0 },
        "total_used": { "type": "integer", "minimum": 0 },
        "total_outputs": { "type": "integer", "minimum": 0 },
        "outputs_in_report": { "type": "integer", "minimum": 0 },
        "output_coverage_ratio": { "const": 1 },
        "high_signal_candidates": { "type": "integer", "minimum": 0 },
        "high_signal_used": { "type": "integer", "minimum": 0 },
        "high_signal_usage_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "shared_clip_candidates": { "type": "integer", "minimum": 0 },
        "shared_clip_indexed": { "type": "integer", "minimum": 0 },
        "sources_missing": { "type": "array", "items": { "type": "string" } },
        "low_usage_explanation": { "type": "string" },
        "session_agents": {
          "type": "object",
          "description": "本周各 agent 的 session 计数",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
