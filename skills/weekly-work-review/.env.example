# 周复盘归档根目录。必须指向 Vault 根目录；不要填周目录。
WEEKLY_REVIEW_VAULT_ROOT=

# Vault 内周复盘相对目录。
WEEKLY_REVIEW_ARCHIVE_RELATIVE_DIR=工作/周报

# Vault 外原始证据暂存根目录。不得位于 WEEKLY_REVIEW_VAULT_ROOT 内。
WEEKLY_REVIEW_SCRATCH_ROOT=

# 可选。留空时使用机器本地时区。
WEEKLY_REVIEW_TIMEZONE=

# 当前仓库 Slack skill 根目录；默认可由 skill 自身定位 ../slack。
WEEKLY_REVIEW_SLACK_SKILL_DIR=

# Vault 内会议归档相对目录。
WEEKLY_REVIEW_MEETINGS_RELATIVE_DIR=工作/会议

# 可选。memory-manager CLI（cli.js 绝对路径）。留空时按 PATH 与已知位置探测。
# 提供 claude / codex / opencode / pi / copilot / cursor 的多 agent session 索引。
WEEKLY_REVIEW_MEMORY_MANAGER_CLI=

# 可选。旧 session-archaeology 兼容项，未安装留空即可。
WEEKLY_REVIEW_SESSION_ARCHAEOLOGY_DIR=
